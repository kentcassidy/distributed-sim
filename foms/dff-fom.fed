;; Distributed Flight-Dynamics FOM -- HLA 1.3 (.fed) form.
;;
;; Used to bring up the handshake instead of the 1516e XML: the .fed format
;; carries NO datatypes (attributes are opaque byte buffers, which is exactly
;; what Encoding.cpp produces), and it is the format the vendored C++ example is
;; proven against. Root object class is ObjectRoot (1.3 name), NOT HLAobjectRoot.
;;
;; Transport/order per attribute: reliable|best_effort  timestamp|receive.
;;   - identity/inertial attrs -> receive (no timestamp needed)
;;   - kinematic state         -> timestamp (ready for conservative time mgmt)
(FED
  (Federation DffFederation)
  (FEDversion v1.3)
  (objects
    (class ObjectRoot
      (attribute privilegeToDelete reliable timestamp)
      (class Aircraft
        (attribute EntityId    reliable receive)
        (attribute Mass        reliable receive)
        (attribute Radius      reliable receive)
        (attribute Position    reliable timestamp)
        (attribute Velocity    reliable timestamp)
        (attribute Orientation reliable timestamp)
      )
    )
  )
  (interactions
    ;; Control-plane messages for config-driven partitioning (ADR-0015). No datatypes in
    ;; .fed form -> every parameter is an opaque byte buffer we encode via Encoding.*,
    ;; exactly like the object attributes. All 'receive' order: these are commands
    ;; delivered as they arrive (no time management yet).
    (class InteractionRoot reliable timestamp
      ;; federate -> controller: "I have joined; here is my name." The controller collects
      ;; these into the roster; K = roster size when the user starts the run.
      (class Enroll reliable receive
        (parameter FederateName)
      )
      ;; controller -> federate: "you (TargetFederate) own EntityId, starting from this
      ;; state." One interaction per entity; re-sending one later is how migration will
      ;; reassign ownership.
      (class AssignEntity reliable receive
        (parameter TargetFederate)
        (parameter EntityId)
        (parameter Position)
        (parameter Velocity)
        (parameter Orientation)
        (parameter AngularV)
      )
      ;; controller -> federate: "your sector is this AABB." One per federate (its slab, even
      ;; if currently empty), so an owner can detect an aircraft drifting out of its region
      ;; (a handoff candidate), and an idle federate knows the region it may receive into.
      (class AssignSector reliable receive
        (parameter TargetFederate)
        (parameter SectorId)
        (parameter Min)
        (parameter Max)
      )
      ;; federate -> federate: PEER-TO-PEER ownership transfer (migration). The owning
      ;; federate detects that an aircraft has left its sector, computes the destination
      ;; owner itself from the broadcast partition map, and sends this DIRECTLY to that
      ;; federate carrying the aircraft's exact state and the logical Step the state is
      ;; valid at. The controller neither publishes nor subscribes this -- so the FOM itself
      ;; proves the controller is OUT of the runtime migration loop. Kept separate from
      ;; AssignEntity on purpose: AssignEntity = ownership CREATED centrally at bootstrap,
      ;; Handoff = ownership MOVED between peers at runtime.
      (class Handoff reliable receive
        (parameter TargetFederate)
        (parameter EntityId)
        (parameter Position)
        (parameter Velocity)
        (parameter Orientation)
        (parameter AngularV)
        (parameter Step)
      )
      ;; controller -> all: "begin," carrying the shared run config: fixed dt, the world
      ;; volume, and the RUN LENGTH (NumSteps). Disseminating the bounds gives every owner
      ;; identical inputs; disseminating NumSteps makes the controller -- not the federate --
      ;; own how long the run is, so every federate stops at the SAME logical end (the
      ;; prerequisite for a federate to carry a handed-off aircraft to that shared end).
      (class StartRun reliable receive
        (parameter Dt)
        (parameter WorldMin)
        (parameter WorldMax)
        (parameter NumSteps)
      )
      ;; controller -> all: end the run. Federates HOLD (keep serving) after finishing their
      ;; steps until this arrives, then resign together -- so there can always be more work
      ;; (e.g. handoffs) until the controller declares the sim complete.
      (class Shutdown reliable receive)
    )
  )
)
