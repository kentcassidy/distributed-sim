<?xml version="1.0" encoding="UTF-8"?>
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2010"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

    <!-- Identification / documentation for Portico parsing -->
    <modelIdentification>
        <name>Distributed Flight-Dynamics FOM</name>
        <type>FOM</type>
        <version>0.1</version>
        <modificationDate>2026-09-05</modificationDate>
        <securityClassification>Unclassified</securityClassification>
        <purpose>Aircraft entity-state exchange for the DFF federation</purpose>
        <applicationDomain>Distributed flight-dynamics simulation</applicationDomain>
    </modelIdentification>

    <objects>
        <!-- Portico's 1516e DIF parser wants <name> as a CHILD ELEMENT (not a
             name="..." attribute), and every <attribute> must carry the full
             element sequence INCLUDING an empty <dimensions/> before
             <transportation>. Structure mirrors Portico's shipped example FOMs. -->
        <objectClass>
            <name>HLAobjectRoot</name>
            <objectClass>
                <name>Aircraft</name>
                <sharing>PublishSubscribe</sharing>

                <!-- Identity + inertial properties: Static = sent once at
                     registration, never updated. EntityId ties the HLA instance
                     to a C++ Aircraft. -->
                <attribute>
                    <name>EntityId</name>
                    <dataType>HLAinteger32BE</dataType>
                    <updateType>Static</updateType>
                    <updateCondition>NA</updateCondition>
                    <ownership>NoTransfer</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <dimensions/>
                    <transportation>HLAreliable</transportation>
                    <order>Receive</order>
                </attribute>
                <attribute>
                    <name>Mass</name>
                    <dataType>HLAfloat64BE</dataType>
                    <updateType>Static</updateType>
                    <updateCondition>NA</updateCondition>
                    <ownership>NoTransfer</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <dimensions/>
                    <transportation>HLAreliable</transportation>
                    <order>Receive</order>
                </attribute>
                <attribute>
                    <name>Radius</name>
                    <dataType>HLAfloat64BE</dataType>
                    <updateType>Static</updateType>
                    <updateCondition>NA</updateCondition>
                    <ownership>NoTransfer</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <dimensions/>
                    <transportation>HLAreliable</transportation>
                    <order>Receive</order>
                </attribute>

                <!-- Kinematic state: Periodic (sent each step / on DR threshold),
                     TimeStamp order so conservative time management can order them.
                     Position is the only one wired for today's handshake. -->
                <attribute>
                    <name>Position</name>
                    <dataType>Vector3D</dataType>
                    <updateType>Periodic</updateType>
                    <updateCondition>On advance</updateCondition>
                    <ownership>NoTransfer</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <dimensions/>
                    <transportation>HLAreliable</transportation>
                    <order>TimeStamp</order>
                </attribute>
                <attribute>
                    <name>Velocity</name>
                    <dataType>Vector3D</dataType>
                    <updateType>Periodic</updateType>
                    <updateCondition>On advance</updateCondition>
                    <ownership>NoTransfer</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <dimensions/>
                    <transportation>HLAreliable</transportation>
                    <order>TimeStamp</order>
                </attribute>
                <attribute>
                    <name>Orientation</name>
                    <dataType>Quaternion</dataType>
                    <updateType>Periodic</updateType>
                    <updateCondition>On advance</updateCondition>
                    <ownership>NoTransfer</ownership>
                    <sharing>PublishSubscribe</sharing>
                    <dimensions/>
                    <transportation>HLAreliable</transportation>
                    <order>TimeStamp</order>
                </attribute>
            </objectClass>
        </objectClass>
    </objects>

    <!-- No custom interactions yet; the root must still be present. -->
    <interactions>
        <interactionClass>
            <name>HLAinteractionRoot</name>
        </interactionClass>
    </interactions>

    <!-- Custom datatypes. HLAfloat64BE / HLAinteger32BE are predefined by the MIM. -->
    <dataTypes>
        <arrayDataTypes>
            <arrayData>
                <name>Vector3D</name>
                <dataType>HLAfloat64BE</dataType>
                <cardinality>3</cardinality>
                <encoding>HLAfixedArray</encoding>
            </arrayData>
            <arrayData>
                <name>Quaternion</name>
                <dataType>HLAfloat64BE</dataType>
                <cardinality>4</cardinality>
                <encoding>HLAfixedArray</encoding>
            </arrayData>
        </arrayDataTypes>
    </dataTypes>

</objectModel>
